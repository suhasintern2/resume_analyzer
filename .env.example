APP_ENV=development

# Database (SQLAlchemy sync/async URL; psycopg3 driver)
DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume
# Used by docker-compose.yml to provision the local Postgres container
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume
POSTGRES_PORT=5432

LLM_PROVIDER=gemini
LLM_API_KEY=your_key_here
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash

MAX_FILE_SIZE_MB=4
MAX_RESUME_CHARACTERS=50000

# Handwritten answer scripts (Task 9) — validated separately from resumes
ANSWER_SCRIPT_MAX_FILE_SIZE_MB=10

LLM_TIMEOUT_SECONDS=60

MIN_RESUME_TEXT_LENGTH=200

# Record-file retention window (amendment §6): the scheduled retention job
# (scripts/retention_job.py) purges record files + their files rows only for
# interviews whose evaluation is complete AND older than this many days.
RETENTION_DAYS=30

# Background worker (Task 8): a lightweight polling loop inside the app —
# no Celery/Kafka/Redis. Job state lives in the `interviews` table.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2

# Task 10 — Deterministic evaluator weights (must sum to 1.0)
KEYWORD_WEIGHT=0.20
CONCEPT_WEIGHT=0.30
PHRASE_WEIGHT=0.15
SIMILARITY_WEIGHT=0.20
STRUCTURE_WEIGHT=0.15
EVALUATOR_VERSION=v1.0.0-deterministic

# Task 12 — AI-free answer-script pipeline (OMR + TrOCR).
# TrOCR model for handwriting recognition (Microsoft, via Hugging Face transformers).
# Options: microsoft/trocr-base-handwritten (faster), microsoft/trocr-large-handwritten (more accurate)
TROCR_MODEL=microsoft/trocr-base-handwritten
# Device: "cpu" or "cuda" (if available and GPU memory permits)
TROCR_DEVICE=cpu
# Working DPI scanned answer pages are rasterized to before OMR detection.
OMR_DPI=200
# A checkbox interior is "marked" when its dark-pixel ratio >= threshold.
OMR_INK_THRESHOLD=0.18
# Tesseract binary override (kept for backward compat / optional fallback).
TESSERACT_CMD=tesseract

# Task 13 — MCQ Question Bank.
# Directory for storing generated MCQ question papers.
MCQ_STORAGE_DIR=generated/mcq_sheets
# Path to the MCQ dataset JSON file.
MCQ_DATASET_PATH=generated/mcq_bank/mcq_dataset.json
# Directory for storing MCQ results.
MCQ_RESULTS_DIR=generated/mcq_results
# Server host and port for the FastAPI backend.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
